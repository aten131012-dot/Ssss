						HB.orig[r] = { Size = r.Size, Transparency = r.Transparency, Color = r.Color, Material = r.Material, CanCollide = r.CanCollide }
					end
					if r.Size.X ~= s then r.Size = Vector3.new(s, s, s) end
					r.Transparency = 0.6
