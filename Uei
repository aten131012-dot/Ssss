do
	local T = { list = {}, run = true }
	NX.T = T

	local function pickPart(m, names)
		for _, n in ipairs(names) do
			local p = m:FindFirstChild(n)
			if p and p:IsA("BasePart") then return p end
		end
	end
	local function mkInfo(m, plr)
		local root = pickPart(m, { "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso" }) or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
		if not root then return nil end
		return {
			model = m, plr = plr, hum = m:FindFirstChildOfClass("Humanoid"),
			root = root, head = pickPart(m, { "Head" }) or root,
			name = plr and plr.DisplayName or m.Name,
		}
	end
	function T.scan()
		local me, new, seen = Player.Character, {}, {}
		local function add(m, plr)
			if not m or seen[m] or m == me then return end
			seen[m] = true
			local i = mkInfo(m, plr)
			if i then new[#new + 1] = i end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= Player then add(plr.Character, plr) end
		end
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("Humanoid") and d.Parent and d.Parent:IsA("Model") then
				add(d.Parent, Players:GetPlayerFromCharacter(d.Parent))
			end
		end
		local out = {}
		for _, i in ipairs(new) do
			if i.model.Name ~= "NX_Clone" then out[#out + 1] = i end
		end
		T.list = out
	end
	function T.alive()
		local r = {}
		for _, i in ipairs(T.list) do
			if i.model.Parent and i.root.Parent and (not i.hum or i.hum.Health > 0) then r[#r + 1] = i end
		end
		return r
	end
	function T.isTeam(i)
		if not i.plr then return false end
		if Player.Team and i.plr.Team and Player.Team == i.plr.Team then return true end
		if Player.TeamColor and i.plr.TeamColor and Player.TeamColor == i.plr.TeamColor then return true end
		return false
	end
	task.spawn(function()
		while T.run do
			pcall(T.scan)
			task.wait(1.5)
		end
	end)
	table.insert(NX.Cleanups, function() T.run = false end)
end

