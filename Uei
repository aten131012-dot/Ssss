			pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
			pe.Parent = r
			table.insert(fx.objs, pe)
			fx.conn = RunService.Heartbeat:Connect(function()
				pe.Color = ColorSequence.new(Color3.fromHSV((os.clock() * 0.25) % 1, 1, 1))
			end)
