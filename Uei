	local function conv(s, map)
		local pre, rest = NX.SplitPre(s)
		local r = map[rest]
		if r then return pre .. r end
		return s
	end
	function NX.ApplyLang(lang)
		NX.Lang = lang
		local map = (lang == "en") and D or Rev
		for _, root in ipairs(NX.LangRoots) do
			for _, d in ipairs(root:GetDescendants()) do
				if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and not d:GetAttribute("NoLang") then
					local t = conv(d.Text, map)
					if t ~= d.Text then d.Text = t end
					if d:IsA("TextBox") then
						local p = conv(d.PlaceholderText, map)
						if p ~= d.PlaceholderText then d.PlaceholderText = p end
					end
				end
			end
		end
		btnTh.BackgroundColor3 = (lang == "th") and Theme.Accent or Theme.Panel2
		btnEn.BackgroundColor3 = (lang == "en") and Theme.Accent or Theme.Panel2
	end
	btnTh.MouseButton1Click:Connect(function() NX.ApplyLang("th") end)
	btnEn.MouseButton1Click:Connect(function() NX.ApplyLang("en") end)
	btnTh.BackgroundColor3 = Theme.Accent
