SectionHdr(SSF, "🎨  THEME")
do
	local DarkSet = { Dark = DARK, Panel = PANEL, Panel2 = PANEL2, Box = Color3.fromRGB(26, 28, 38), Text = WHITE }
	local LightSet = {
		Dark = Color3.fromRGB(232, 234, 241), Panel = Color3.fromRGB(245, 246, 250),
		Panel2 = Color3.fromRGB(222, 225, 234), Box = Color3.fromRGB(208, 212, 224), Text = Color3.fromRGB(24, 26, 34),
	}
	local Accents = {
		Color3.fromRGB(255, 25, 45), Color3.fromRGB(150, 70, 255), Color3.fromRGB(45, 140, 255),
		Color3.fromRGB(0, 200, 210), Color3.fromRGB(255, 80, 170), Color3.fromRGB(255, 140, 30),
	}
	local function ApplyTheme(over)
		local oldT = {}
		for k, v in pairs(Theme) do oldT[k] = v end
		local new = {}
		for k, v in pairs(oldT) do if over[k] ~= nil then new[k] = over[k] else new[k] = v end end
		local function map(c)
			if c == oldT.Accent then return new.Accent end
			if c == oldT.Dark then return new.Dark end
			if c == oldT.Panel then return new.Panel end
			if c == oldT.Panel2 then return new.Panel2 end
			if c == oldT.Box then return new.Box end
		end
		for _, d in ipairs(Gui:GetDescendants()) do
			if not d:GetAttribute("NoTheme") then
				if d:IsA("GuiObject") then
					local accBg = d.BackgroundTransparency < 1 and d.BackgroundColor3 == oldT.Accent
					local m = map(d.BackgroundColor3)
					if m then d.BackgroundColor3 = m end
					if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
						if d.TextColor3 == oldT.Accent then d.TextColor3 = new.Accent
						elseif d.TextColor3 == oldT.Text and not accBg then d.TextColor3 = new.Text end
					end
					if d:IsA("ScrollingFrame") and d.ScrollBarImageColor3 == oldT.Accent then d.ScrollBarImageColor3 = new.Accent end
				elseif d:IsA("UIStroke") and d.Color == oldT.Accent then
					d.Color = new.Accent
				end
			end
		end
		for k, v in pairs(new) do Theme[k] = v end
		local a, wh = new.Accent, Color3.new(1, 1, 1)
		NexoraTitle.TextColor3 = wh
		NexoraGradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, a), ColorSequenceKeypoint.new(1, a:Lerp(wh, 0.45)) })
		HubTitle.TextColor3 = wh
		HubGradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, new.Text), ColorSequenceKeypoint.new(1, a) })
