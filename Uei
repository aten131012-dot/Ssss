function NX.SplitPre(s)
	for p, c in utf8.codes(s) do
		if (c >= 0x0E00 and c <= 0x0E7F) or (c < 128 and string.char(c):match("%w")) then
			return s:sub(1, p - 1), s:sub(p)
		end
	end
	return s, ""
end
function NX.TT(s)
	if NX.Lang ~= "en" then return s end
	local pre, rest = NX.SplitPre(s)
	return pre .. (NX.Dict[rest] or rest)
end
