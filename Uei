	local alpha = 1
	local function proc(d)
		local c = OpCache[d]
		if not c then
			c = {}
			if d:IsA("GuiObject") then c.bg = d.BackgroundTransparency end
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				c.tx = d.TextTransparency
				c.ts = d.TextStrokeTransparency
			end
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then c.im = d.ImageTransparency end
			if d:IsA("UIStroke") then c.st = d.Transparency end
			OpCache[d] = c
		end
		local function f(o) return 1 - (1 - o) * alpha end
		if c.bg then d.BackgroundTransparency = f(c.bg) end
		if c.tx then d.TextTransparency = f(c.tx) end
		if c.ts then d.TextStrokeTransparency = f(c.ts) end
		if c.im then d.ImageTransparency = f(c.im) end
		if c.st then d.Transparency = f(c.st) end
	end
	SliderRow(SSF, "💧  ความโปร่งใส UI (ความทึบ)", 20, 100, 100, 5, "%", function(v)
		alpha = v / 100
		proc(Main)
		for _, d in ipairs(Main:GetDescendants()) do proc(d) end
	end)
end

