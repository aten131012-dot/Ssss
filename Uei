	local function camDir(md, cam)
		if md.Magnitude < 0.05 then return Vector3.zero end
		local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
		local fl, fr = Vector3.new(look.X, 0, look.Z), Vector3.new(right.X, 0, right.Z)
		fl = fl.Magnitude > 0.01 and fl.Unit or Vector3.zero
		fr = fr.Magnitude > 0.01 and fr.Unit or Vector3.zero
		return look * md:Dot(fl) + right * md:Dot(fr)
	end

