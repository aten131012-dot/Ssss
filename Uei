				if x:IsA("BaseScript") or x:IsA("BodyMover") or x:IsA("Highlight") or x:IsA("Fire")
					or x:IsA("ParticleEmitter") or x:IsA("PointLight") then
					pcall(function() x:Destroy() end)
				end
			end
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") or t:IsA("ForceField") then t:Destroy() end
			end
			c.Name = "NX_Clone"
			local hum, hrp = c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
			if not hum or not hrp then c:Destroy(); return end
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.PlatformStand = false
			c.Parent = workspace
			local d = { model = c, hum = hum, hrp = hrp, base = cf, r15 = hum.RigType == Enum.HumanoidRigType.R15, orig = {} }
			for _, m in ipairs(c:GetDescendants()) do
				if m:IsA("Motor6D") then d.orig[m] = m.C0 end
			end
			table.insert(CP.list, d)
			applyDummy(d)
		end

		local function frontCF()
			local r = GetHRP(GetChar())
			if not r then return nil end
			local look = Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z)
			look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
			local pos = r.Position + look * 6
			return CFrame.lookAt(pos, Vector3.new(r.Position.X, pos.Y, r.Position.Z))
		end

		local function placeAt(res)
			if not res then return end
			local r = GetHRP(GetChar())
			local pos = res.Position + Vector3.new(0, 3, 0)
			local face = r and Vector3.new(r.Position.X, pos.Y, r.Position.Z) or (pos + Vector3.new(0, 0, 1))
			if (face - pos).Magnitude < 0.1 then face = pos + Vector3.new(0, 0, 1) end
			spawnDummy(CFrame.lookAt(pos, face))
		end
		local function castFrom(ray)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local ex = { Player.Character }
			for _, d in ipairs(CP.list) do ex[#ex + 1] = d.model end
			params.FilterDescendantsInstances = ex
			return workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
		end

