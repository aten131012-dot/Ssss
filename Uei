				local t = os.clock()
				for i, p in ipairs(balls) do
					local a = t * 2 + i * math.pi / 4
					p.Position = hrp.Position + Vector3.new(math.cos(a) * 5, math.sin(t * 3 + i) * 1.5, math.sin(a) * 5)
					p.Color = Color3.fromHSV((t * 0.3 + i / 8) % 1, 1, 1)
				end
