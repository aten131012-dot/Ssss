do
	local Teams = game:GetService("Teams")
	local KEYS = { "Team", "TeamName", "TeamColor", "Side", "Faction", "Squad" }
	local function add(set, v)
		if v == nil then return end
		local s = tostring(v):lower()
		if s ~= "" and s ~= "nil" then set[s] = true end
	end
	local function keysOf(model, plr)
		local set = {}
		if plr then
			if plr.Team then add(set, plr.Team.Name); add(set, plr.Team.TeamColor) end
			if not plr.Neutral then add(set, plr.TeamColor) end
			for _, k in ipairs(KEYS) do add(set, plr:GetAttribute(k)) end
		end
		if model then
			for _, k in ipairs(KEYS) do
				add(set, model:GetAttribute(k))
				local v = model:FindFirstChild(k)
				if v and v:IsA("ValueBase") then add(set, v.Value) end
			end
			local p = model.Parent
			while p and p ~= workspace and p ~= game do
				for _, t in ipairs(Teams:GetTeams()) do
					if p.Name:lower() == t.Name:lower() then add(set, t.Name) end
				end
				p = p.Parent
			end
		end
		return set
	end
	local mineSet, mineT = {}, 0
	local function mine()
		if os.clock() - mineT > 0.5 then
			mineT = os.clock()
			mineSet = keysOf(Player.Character, Player)
		end
		return mineSet
	end
	NX.T.isTeam = function(i)
		local m = mine()
		if next(m) == nil then return false end
		local theirs = keysOf(i.model, i.plr)
		for k in pairs(theirs) do
			if m[k] then return true end
		end
		return false
	end
end

