function NX.Run(url, arg)
	NX.Active = true
	NX.WindowUntil = os.clock() + 20
	local done, ok = false, true
	local th = task.spawn(function()
		ok = pcall(function() loadstring(game:HttpGet(url, true))(arg) end)
		done = true
	end)
	table.insert(NX.Threads, th)
	local t0 = os.clock()
	while not done and os.clock() - t0 < 2.5 do task.wait() end
	if not done then return true end
	return ok
end

