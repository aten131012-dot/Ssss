	knob.Position = UDim2.new(0, 0, 0.5, 0)
	knob.BackgroundColor3 = WHITE
	knob.Parent = bar
	Corner(knob, 14)
	local value = defV
	local function setVisual(v)
		local rel = math.clamp((v - minV) / (maxV - minV), 0, 1)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valLbl.Text = tostring(v) .. suffix
	end
	setVisual(defV)
	local dragging = false
	local sf = parent:IsA("ScrollingFrame") and parent or nil
	local function fromX(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local v = math.clamp(math.floor((minV + rel * (maxV - minV)) / step + 0.5) * step, minV, maxV)
		v = math.floor(v * 1000 + 0.5) / 1000
		if v ~= value then
			value = v
			setVisual(v)
			pcall(onChange, v)
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			if sf then sf.ScrollingEnabled = false end
			fromX(input.Position.X)
		end
	end)
	table.insert(NX.Conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end))
	table.insert(NX.Conns, UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			if sf then sf.ScrollingEnabled = true end
		end
	end))
	return { Set = function(v) value = v; setVisual(v) end, Frame = ctr }
end
-- Part 3: Target & Entity System
do
	local T = { list = {}, run = true }
	NX.T = T

	local function pickPart(m, names)
		for _, n in ipairs(names) do
			local p = m:FindFirstChild(n)
			if p and p:IsA("BasePart") then return p end
		end
	end
	local function mkInfo(m, plr)
		local root = pickPart(m, { "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso" }) or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
		if not root then return nil end
		return {
			model = m, plr = plr, hum = m:FindFirstChildOfClass("Humanoid"),
			root = root, head = pickPart(m, { "Head" }) or root,
			name = plr and plr.DisplayName or m.Name,
		}
	end
	function T.scan()
		local me, new, seen = Player.Character, {}, {}
		local function add(m, plr)
			if not m or seen[m] or m == me then return end
			seen[m] = true
			local i = mkInfo(m, plr)
			if i then new[#new + 1] = i end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= Player then add(plr.Character, plr) end
		end
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("Humanoid") and d.Parent and d.Parent:IsA("Model") then
				add(d.Parent, Players:GetPlayerFromCharacter(d.Parent))
			end
		end
		local out = {}
		for _, i in ipairs(new) do
			if i.model.Name ~= "NX_Clone" then out[#out + 1] = i end
		end
		T.list = out
	end
	function T.alive()
		local r = {}
		for _, i in ipairs(T.list) do
			if i.model.Parent and i.root.Parent and (not i.hum or i.hum.Health > 0) then r[#r + 1] = i end
		end
		return r
	end
	function T.isTeam(i)
		if not i.plr then return false end
		if Player.Team and i.plr.Team and Player.Team == i.plr.Team then return true end
		if Player.TeamColor and i.plr.TeamColor and Player.TeamColor == i.plr.TeamColor then return true end
		return false
	end
	task.spawn(function()
		while T.run do
			pcall(T.scan)
			task.wait(1.5)
		end
	end)
	table.insert(NX.Cleanups, function() T.run = false end)
end

do
	local Teams = game:GetService("Teams")
	local KEYS = { "Team", "TeamName", "TeamColor", "Side", "Faction", "Squad" }
	local function add(set, v)
		if v == nil then return end
		local s = tostring(v):lower()
		if s ~= "" and s ~= "nil" then set[s] = true end
	end
	local function keysOf(model, plr)
		local set = {}
		if plr then
			if plr.Team then add(set, plr.Team.Name); add(set, plr.Team.TeamColor) end
			if not plr.Neutral then add(set, plr.TeamColor) end
			for _, k in ipairs(KEYS) do add(set, plr:GetAttribute(k)) end
		end
		if model then
			for _, k in ipairs(KEYS) do
				add(set, model:GetAttribute(k))
				local v = model:FindFirstChild(k)
				if v and v:IsA("ValueBase") then add(set, v.Value) end
			end
			local p = model.Parent
			while p and p ~= workspace and p ~= game do
				for _, t in ipairs(Teams:GetTeams()) do
					if p.Name:lower() == t.Name:lower() then add(set, t.Name) end
				end
				p = p.Parent
			end
		end
		return set
	end
	local mineSet, mineT = {}, 0
	local function mine()
		if os.clock() - mineT > 0.5 then
			mineT = os.clock()
			mineSet = keysOf(Player.Character, Player)
		end
		return mineSet
	end
	NX.T.isTeam = function(i)
		local m = mine()
		if next(m) == nil then return false end
		local theirs = keysOf(i.model, i.plr)
		for k in pairs(theirs) do
			if m[k] then return true end
		end
		return false
	end
end
