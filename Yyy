			if not itemEspActive then return end
			local cam = workspace.CurrentCamera
			if not cam then return end
			local hrp = GetHRP(GetChar())
			local myPos = hrp and hrp.Position or cam.CFrame.Position

			local itemsFound = {}
			for _, d in ipairs(workspace:GetDescendants()) do
				if (d:IsA("Tool") or d:IsA("BasePart")) and not d:IsDescendantOf(Player.Character) then
					local pos = d:IsA("Model") and (d.PrimaryPart and d.PrimaryPart.Position or d:GetPivot().Position) or (d:IsA("BasePart") and d.Position or nil)
					if pos then
						local dist = math.floor((pos - myPos).Magnitude + 0.5)
						if dist <= 300 then
							table.insert(itemsFound, { name = d.Name, pos = pos, dist = dist })
						end
					end
				end
			end

			for idx, l in ipairs(labels) do l.Visible = false end

			for idx, info in ipairs(itemsFound) do
				if idx > 80 then break end
				local screenPos, onScreen = cam:WorldToViewportPoint(info.pos + Vector3.new(0, 1.5, 0))
				local l = getLabel(idx)
				if onScreen and screenPos.Z > 0 then
					l.Text = info.name .. " [" .. info.dist .. "m]"
					l.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
					l.Visible = true
				else
					l.Visible = false
				end
			end
		end

		local espConn = nil
		ToggleRow(TF, "🔍  ค้นหาและแสดงชื่อไอเทม/วัตถุบนจอ", function()
			itemEspActive = true
			itemEspGui.Enabled = true
			if espConn then espConn:Disconnect() end
			espConn = RunService.RenderStepped:Connect(updateItemESP)
		end, function()
			itemEspActive = false
			itemEspGui.Enabled = false
			if espConn then espConn:Disconnect(); espConn = nil end
			for _, l in ipairs(labels) do l.Visible = false end
		end)
		table.insert(NX.Cleanups, function()
			itemEspActive = false
			pcall(function() itemEspGui:Destroy() end)
		end)
	end
end
