do
	local Aim = { On = false, NoTeam = false, Target = nil }
	NX.Aim = Aim
	local bound = false

	local function anyPart(m)
		return m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
	end
	local function targetPos()
		if Aim.Target then
			local m = Aim.Target.plr and Aim.Target.plr.Character or Aim.Target.model
			if m and m.Parent then
				local h = m:FindFirstChildOfClass("Humanoid")
				if not h or h.Health > 0 then
					local p = anyPart(m)
					return p and p.Position
				end
			end
			return nil
		end
		if Aim.On then
			local cam = workspace.CurrentCamera
			local mr = GetHRP(GetChar())
			local from = mr and mr.Position or (cam and cam.CFrame.Position)
			if not from then return nil end
			local best, bd = nil, math.huge
			for _, i in ipairs(NX.T.alive()) do
				if not (Aim.NoTeam and NX.T.isTeam(i)) then
					local d = (i.head.Position - from).Magnitude
					if d < bd then bd = d; best = i.head.Position end
				end
			end
			return best
		end
	end
	local function step()
		pcall(function()
			local cam = workspace.CurrentCamera
			local p = targetPos()
			if cam and p then cam.CFrame = CFrame.new(cam.CFrame.Position, p) end
		end)
	end
	function NX.UpdateAim()
		local need = Aim.On or Aim.Target ~= nil
		if need and not bound then
			RunService:BindToRenderStep("NEXORA_Aim", Enum.RenderPriority.Camera.Value + 1, step)
			bound = true
		elseif not need and bound then
			pcall(function() RunService:UnbindFromRenderStep("NEXORA_Aim") end)
			bound = false
		end
	end
	table.insert(NX.Cleanups, function() Aim.On = false; Aim.Target = nil; NX.UpdateAim() end)
end

